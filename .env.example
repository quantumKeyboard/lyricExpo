# Copy this file to .env and fill in your values.
# Anything left blank just falls back to the in-app sidebar fields.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: pre-fill the "type a path" chat-file option. Leave blank if
# you'd rather use the Browse/upload option in the app every time.
CHAT_TXT_PATH=

# Folder WhatsApp exported the images into
MEDIA_FOLDER=

# Where the Obsidian vault + JSON mirror get written
VAULT_ROOT=./LyricsVault
DATA_ROOT=./LyricsVaultData
